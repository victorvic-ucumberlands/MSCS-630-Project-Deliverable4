# ===== Figure 8: no synchronization, the correct solution, and the wrong lock order =====
# (Deliverable 4: log in as admin first; the script runs from the shell's own directory)
cd $MYSHELL_DIR
# --- without semaphores, two CPUs at once (sched live off): items lost / duplicated ---
rm -f pc.log
./demos/pc init 8
sched live off
./demos/pc producer 1 400 --nosync & ./demos/pc producer 2 400 --nosync & ./demos/pc consumer 1 400 --nosync & ./demos/pc consumer 2 400 --nosync &
sleep 4
./demos/pc check pc.log 2 400
# --- the same with semaphores empty/full and the mutex: every item exactly once ---
rm -f pc.log
./demos/pc init 8
./demos/pc producer 1 400 & ./demos/pc producer 2 400 & ./demos/pc consumer 1 400 & ./demos/pc consumer 2 400 &
sleep 2
./demos/pc check pc.log 2 400
sched live on
# --- wrong order (mutex before empty/full): deadlock, reported by the shell ---
rm -f pc.log
./demos/pc init 2
./demos/pc producer 1 10 --bad-order & ./demos/pc consumer 1 10 --bad-order -t 50 &
sleep 1.5
sem
sched ps
kill %1 %2
sleep 0.3
rm -f pc.log
