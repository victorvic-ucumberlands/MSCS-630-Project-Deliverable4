# ===== Figure 9: the naive philosophers deadlock; the shell detects it; recovery =====
# (Deliverable 4: log in as admin first; the script runs from the shell's own directory)
cd $MYSHELL_DIR
sem reset
./demos/philo 0 5 2 --naive --pause 100 & ./demos/philo 1 5 2 --naive --pause 100 & ./demos/philo 2 5 2 --naive --pause 100 & ./demos/philo 3 5 2 --naive --pause 100 & ./demos/philo 4 5 2 --naive --pause 100 &
sleep 1.5
sem
sched ps
sem deadlock
# --- recovery: kill philosopher 0; the shell releases its fork (robust mutex) ---
sem trace on
kill %1
sleep 1
sem trace off
jobs
