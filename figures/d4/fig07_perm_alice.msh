# ===== D4 Figure 7: permissions of a standard user (alice) - allowed and denied =====
# (log in as alice / alice123, then: source $MYSHELL_DIR/figures/d4/fig07_perm_alice.msh)
cd
# --- ALLOWED: her own files (owner rw-) ---
ls -l
echo "alice: buy milk" >> notes.txt
cat notes.txt
# --- ALLOWED: reading the system configuration (others r--) ---
cat ../../system/config
# --- DENIED: modifying system files ---
echo "max_users=999" >> ../../system/config
rm ../../system/config
touch ../../system/backdoor
# --- DENIED: the secret key (others ---), also through an external program ---
cat ../../system/secret.key
grep KEY ../../system/secret.key
# --- the rule behind each decision ---
access ../../system/config
