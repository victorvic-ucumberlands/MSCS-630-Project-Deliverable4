# ===== D4 Figure 5: two identities in one session - alice (standard), bob (standard), admin =====
# (start: ./myshell, log in as alice / alice123, then: source $MYSHELL_DIR/figures/d4/fig05_two_users.msh)
cd
whoami
id
ls -l
cat notes.txt
# --- alice may read the system configuration, but not the secret key ---
cat ../../system/config
cat ../../system/secret.key
# --- switch user inside the session, like su: type bob's password (bob12345) ---
login bob
whoami
id
ls -l
# --- bob may not even pass through alice's home (drwx------) ---
cat ../alice/notes.txt
# --- the administrator: type admin123; note the '#' prompt ---
login admin
id
cat $MYSHELL_FS/system/secret.key
users
