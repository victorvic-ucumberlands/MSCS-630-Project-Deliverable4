# ===== D4 Figure 9: a second standard user (bob) - group sharing, the sticky bit, the x bit =====
# (log in as bob / bob12345, then: source $MYSHELL_DIR/figures/d4/fig09_sticky_bob.msh)
cd $MYSHELL_FS/shared
ls -l $MYSHELL_FS
ls -l
# --- ALLOWED: group users may write team.txt (rw-rw-r--) ---
echo "bob: reviewed the pipeline" >> team.txt
cat team.txt
# --- ALLOWED: creating and deleting his own file in shared/ (drwxrwxr-t) ---
touch from_bob.txt
rm from_bob.txt
# --- DENIED: the sticky bit - only alice, the owner, may delete or rename her file ---
rm team.txt
mv team.txt mine.txt
access team.txt
# --- his own script runs only after he sets the x bit ---
cd
./report.sh
chmod u+x report.sh
./report.sh
