# ===== D4 Figure 8: execute permission, chmod and the security database =====
# (log in as alice / alice123, then: source $MYSHELL_DIR/figures/d4/fig08_perm_programs.msh)
cd
# --- ALLOWED: a shared tool with x for others (rwxr-xr-x) ---
ls -l ../../bin
../../bin/hello.sh
# --- DENIED: an admin script without x for others (rwxr-x---) ---
ls -l ../../system/maintenance.sh
../../system/maintenance.sh
# --- chmod: the owner may change her own file's mode, not a system file's ---
chmod 600 notes.txt
chmod 777 ../../system/config
chown alice ../../system/config
# --- system-wide settings and user management belong to admin ---
sched policy fifo
prio 1 sleep 0.1
useradd eve
# --- the user database is not reachable through ordinary commands ---
cat $MYSHELL_HOME/passwd
