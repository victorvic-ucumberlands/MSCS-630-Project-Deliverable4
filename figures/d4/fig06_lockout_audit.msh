# ===== D4 Figure 6: wrong passwords, account lock, unlock and the audit log =====
# (log in as alice / alice123, then: source $MYSHELL_DIR/figures/d4/fig06_lockout_audit.msh)
# --- type a WRONG password for bob five times; the 5th failure locks his account ---
login bob
login bob
login bob
login bob
login bob
# --- now type bob's RIGHT password (bob12345): refused, the account is locked ---
login bob
# --- the administrator unlocks it: type admin123 ---
login admin
users
unlock bob
audit 14
# --- bob can log in again: type bob12345 ---
login bob
whoami
