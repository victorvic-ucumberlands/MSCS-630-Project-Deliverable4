# ===== D4 Figure 11: one shell - jobs, semaphores and the scheduler are per user =====
# (log in as alice / alice123, then: source $MYSHELL_DIR/figures/d4/fig11_integration.msh)
cd
# --- alice starts a process that waits on her semaphore ---
sem create alice.gate 0
$MYSHELL_DIR/demos/counter W 1 --seg z --sem alice.gate &
sleep 0.2
sched ps
# --- bob (type bob12345) may neither release her semaphore nor signal her job ---
login bob
jobs
sem post alice.gate
kill %1
sched policy fifo
# --- back to alice (type alice123): she releases it herself ---
login alice
sem post alice.gate
sleep 0.5
jobs
sem rm alice.gate
# --- paging statistics of a real process, counted through a pipe ---
$MYSHELL_DIR/demos/memproc pf 8 7,0,1,2,0,3,0,4,2,3,0,3,2,1,2,0,1,7,0,1 -v | grep "PAGE FAULT" | wc -l
